<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10-11 equivalent of data_extraction_rules.xml: back up nothing. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
