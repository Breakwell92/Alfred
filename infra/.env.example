# Server settings, read by alfred_server.config.Settings (all use the ALFRED_ prefix).
# The server reads `.env` from its working directory, so for local runs:
#   cp infra/.env.example server/.env
# `.env` files are git-ignored. Never commit real values.
# These take effect when the server is started with `uv run python -m alfred_server`.

# Bind address. Keep loopback unless the server must be reachable from other devices.
ALFRED_HOST=127.0.0.1
ALFRED_PORT=8000
# DEBUG | INFO | WARNING | ERROR
ALFRED_LOG_LEVEL=INFO

# --- Speech-to-text (faster-whisper); see docs/decisions/0002-stt.md -----------------
# Load the STT model at startup. Needs `uv sync --extra cuda` for GPU use.
ALFRED_STT_ENABLED=false
ALFRED_STT_MODEL=distil-large-v3
# auto | cuda | cpu
ALFRED_STT_DEVICE=auto
# auto (int8_float16 on CUDA, int8 on CPU) or any CTranslate2 compute type, e.g. float16
ALFRED_STT_COMPUTE_TYPE=auto
# Whisper language code (no en-GB variant exists)
ALFRED_STT_LANGUAGE=en
# Optional text to bias vocabulary/spelling, e.g. "Colour, favourite, Alfred."
# ALFRED_STT_INITIAL_PROMPT=
ALFRED_STT_BEAM_SIZE=1
# Concurrent transcriptions, 1 or 2
ALFRED_STT_MAX_CONCURRENCY=1
# Longest utterance accepted, in seconds; longer audio streams are rejected
ALFRED_STT_MAX_AUDIO_S=30
# Model download directory (mount a volume here in containers); unset uses the Hugging Face cache
# ALFRED_STT_DOWNLOAD_ROOT=
