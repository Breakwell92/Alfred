# One example file for both consumers. Copy it to each place that reads it:
#   cp infra/.env.example infra/.env     # docker compose (run from infra/)
#   cp infra/.env.example server/.env    # the server (reads .env from its working directory)
# `.env` files are git-ignored. Never commit real values; replace every `change-me`.

# --- Server (alfred_server.config.Settings, ALFRED_ prefix) -------------------------
# These take effect when the server is started with `uv run python -m alfred_server`.

# Bind address. Keep loopback unless the server must be reachable from other devices.
ALFRED_HOST=127.0.0.1
ALFRED_PORT=8000
# DEBUG | INFO | WARNING | ERROR
ALFRED_LOG_LEVEL=INFO
# SQLAlchemy URL for Postgres (psycopg 3 driver). Must match the POSTGRES_* values below.
ALFRED_DATABASE_URL=postgresql+psycopg://alfred:change-me@127.0.0.1:5432/alfred
# Ollama HTTP API. Host and port must match OLLAMA_BIND_ADDRESS and OLLAMA_PORT below
# (with a Tailscale bind address nothing listens on 127.0.0.1).
ALFRED_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LiteLLM model gateway (every LLM call goes through it). Host and port must match
# LITELLM_BIND_ADDRESS and LITELLM_PORT below.
ALFRED_LITELLM_BASE_URL=http://127.0.0.1:4000
# Key the server sends to LiteLLM: LITELLM_MASTER_KEY below, or a virtual key made with it.
ALFRED_LITELLM_API_KEY=
# LiteLLM's database (its spend logs, read by the budget service). Unset uses
# ALFRED_DATABASE_URL with the database name changed to `litellm` (LITELLM_DB below).
# ALFRED_LITELLM_DATABASE_URL=postgresql+psycopg://alfred:change-me@127.0.0.1:5432/litellm

# --- Budget (alfred_server.budget); see docs/decisions/0008-budget-service.md -----------
# The cap, tiers and enabled providers are set with PUT /settings/budget, not here.
# IANA timezone: budget months and days start at local midnight.
ALFRED_TIMEZONE=Europe/London
# Fixed USD→GBP rate for converting LiteLLM's USD costs (err on the high side).
ALFRED_BUDGET_USD_TO_GBP=0.80

# Shared bearer token the Android app sends (Settings screen) on every request except /health.
# Required: with it unset, every protected route answers 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ALFRED_API_TOKEN=

# --- Speech-to-text (faster-whisper); see docs/decisions/0002-stt.md -----------------
# Load the STT model at startup. Needs `uv sync --extra cuda` for GPU use.
ALFRED_STT_ENABLED=false
ALFRED_STT_MODEL=distil-large-v3
# auto | cuda | cpu
ALFRED_STT_DEVICE=auto
# auto (int8_float16 on CUDA, int8 on CPU) or any CTranslate2 compute type, e.g. float16
ALFRED_STT_COMPUTE_TYPE=auto
# Whisper language code (no en-GB variant exists)
ALFRED_STT_LANGUAGE=en
# Optional text to bias vocabulary/spelling, e.g. "Colour, favourite, Alfred."
# ALFRED_STT_INITIAL_PROMPT=
ALFRED_STT_BEAM_SIZE=1
# Concurrent transcriptions, 1 or 2
ALFRED_STT_MAX_CONCURRENCY=1
# Longest utterance accepted, in seconds; longer audio streams are rejected
ALFRED_STT_MAX_AUDIO_S=30
# Model download directory (mount a volume here in containers); unset uses the Hugging Face cache
# ALFRED_STT_DOWNLOAD_ROOT=

# --- Text-to-speech (Kokoro, Piper fallback); see docs/decisions/0006-tts.md ----------
# Load the TTS engines at startup (GET /voices answers 503 when false). Download the model
# files first: `uv run python scripts/download_tts_models.py` (in server/).
ALFRED_TTS_ENABLED=false
# Model file directory; unset uses ~/.cache/alfred/tts
# ALFRED_TTS_MODEL_DIR=
# Engine of the default voice: piper (ALFRED_TTS_PIPER_VOICE) | kokoro (ALFRED_TTS_KOKORO_VOICE)
ALFRED_TTS_ENGINE=piper
ALFRED_TTS_KOKORO_VOICE=bm_george
ALFRED_TTS_KOKORO_MODEL=kokoro-v1.0.onnx
ALFRED_TTS_KOKORO_VOICES=voices-v1.0.bin
# auto (CUDA if available, else CPU) | cuda (fall back to Piper rather than run on CPU) | cpu
ALFRED_TTS_KOKORO_DEVICE=auto
# Piper voice used when Piper is the default engine and whenever Kokoro is unavailable
ALFRED_TTS_PIPER_VOICE=en_GB-alan-medium

# --- Compose: Postgres (infra/docker-compose.yml) -----------------------------------
POSTGRES_USER=alfred
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alfred
# Host interface and port for Postgres. Loopback only unless you have a reason.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# --- Compose: Ollama ----------------------------------------------------------------
# Host interface for the Ollama API: 127.0.0.1, or this machine's Tailscale IP (100.x.y.z)
# to reach it from other tailnet devices. Never 0.0.0.0: the API has no authentication.
OLLAMA_BIND_ADDRESS=127.0.0.1
# Host port. Change it if a native Ollama install already uses 11434.
OLLAMA_PORT=11434
OLLAMA_IMAGE_TAG=0.40.10
# Models pulled by infra/scripts/pull-models.sh (space-separated Ollama tags).
# Choices and VRAM numbers: docs/decisions/0003-local-models.md.
OLLAMA_MODELS_ROUTER=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODELS_MAIN="gpt-oss:20b mistral-small3.2:24b-instruct-2506-q4_K_M"
# How many models stay in VRAM at once, and for how long after the last request.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# Default context window (tokens) per loaded model; bigger costs VRAM.
OLLAMA_CONTEXT_LENGTH=16384
# KV cache quantisation: f16 | q8_0 | q4_0.
OLLAMA_KV_CACHE_TYPE=q8_0

# --- Compose: LiteLLM model gateway (infra/litellm/config.yaml, docs/infra.md) ------
# Host interface for the proxy: 127.0.0.1 or this machine's Tailscale IP. Never 0.0.0.0.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000
LITELLM_IMAGE_TAG=v1.106.3
# Admin key for the proxy (must start with "sk-"). Required. Generate one with:
#   python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-change-me
# Encrypts credentials LiteLLM stores in its database. Required; never change it once set.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LITELLM_SALT_KEY=change-me
# Database LiteLLM creates in the compose Postgres for spend logs and keys.
LITELLM_DB=litellm
# Cloud provider keys. Leave empty to disable that alias (cloud-claude, cloud-gpt, cloud-gemini).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides for what each alias points at (Ollama tags / provider model names).
# Defaults are in infra/litellm/config.yaml; see docs/decisions/0005-model-gateway.md.
# LITELLM_LOCAL_ROUTER_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LITELLM_LOCAL_MAIN_MODEL=gpt-oss:20b
# LITELLM_CLOUD_CLAUDE_MODEL=claude-sonnet-5-5
# LITELLM_CLOUD_GPT_MODEL=gpt-6.1-sol
# LITELLM_CLOUD_GEMINI_MODEL=gemini-4-argon
